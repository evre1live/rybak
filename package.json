{
  "name": "rybak",
  "version": "0.1.0",
  "private": true,
  "description": "Рыбак — рыбалка с друзьями от первого лица: голосовой чат, рынок, снасти, свой персонаж",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "build": "node tools/build.js",
    "dev": "node tools/build.js --watch",
    "test": "node --test test/logic.test.js test/net.test.js test/world.test.js test/cloud.test.js test/rooms.test.js test/palette.test.js",
    "test:play": "node test/play.cjs",
    "test:coop": "node test/coop.cjs",
    "balance": "node tools/balance.js",
    "test:devices": "node test/devices.cjs",
    "test:warm": "node test/warm.cjs",
    "test:music": "node test/music.cjs",
    "test:cloud": "node test/cloud.cjs",
    "test:sound": "node test/sound.cjs",
    "test:frames": "node test/frames.cjs",
    "test:restart": "node test/restart.cjs",
    "test:locations": "node test/locations.cjs",
    "solo": "node tools/artifact.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "pg": "^8.23.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/fira-sans-extra-condensed": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  }
}
